<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="1.9.11" />
    <PackageReference Include="MaterialSkin.2" Version="2.3.1" />
    <PackageReference Include="OxyPlot.Core" Version="2.2.0" />
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.2.0" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.1.1" />
    <PackageReference Include="ReaLTaiizor" Version="3.8.1.2" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.4" />
    <PackageReference Include="Zen.Barcode.Rendering.Framework" Version="3.1.10729.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AdminSettings.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DashboardA.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DashboardH.cs" />
    <Compile Update="DashboardD.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="BloodBagBarcodes.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="HospitalExtraction.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Login.cs" />
    <Compile Update="ForgetPassword.cs" />
    <Compile Update="RecordsDonor.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterDP4.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterHP1.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterHP3.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterHP2.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterDP3.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RegisterDP2.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

</Project>